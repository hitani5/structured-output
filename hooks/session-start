#!/usr/bin/env bash
# SessionStart hook for the structured-output plugin.
# Reads STRUCTURED_OUTPUT.md and injects it into the session as context,
# which is what makes the format apply to every turn without the user
# having to keep it in their own CLAUDE.md.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
RULES_FILE="${PLUGIN_ROOT}/STRUCTURED_OUTPUT.md"

# Fail silently rather than breaking the user's session start.
[ -r "$RULES_FILE" ] || exit 0

# python3 ships with macOS and handles JSON escaping correctly, which bash
# parameter substitution does not for edge cases like control characters.
python3 - "$RULES_FILE" <<'PY'
import json, sys

with open(sys.argv[1], encoding="utf-8") as fh:
    rules = fh.read()

# Frame the file as an active instruction. Without this it can read as
# reference material that happens to be in context.
rules = (
    "The following describes how you must format your responses in this "
    "session. Apply it from now on.\n\n" + rules
)

print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": rules,
    }
}))
PY
